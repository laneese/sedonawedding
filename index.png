          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> Baby Registry
    </button>
    <button class="nav-btn" onclick="switchTab('tab-babymoon')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> Babymoon
    </button>
    <button class="nav-btn" onclick="switchTab('tab-theday')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> The Day
    </button>
    <button class="nav-btn" onclick="switchTab('tab-village')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> My Village
    </button>
    <button class="nav-btn" onclick="switchTab('tab-postpartum')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> Postpartum
    </button>
    <button class="nav-btn" onclick="switchTab('tab-firstyear')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> First Year
    </button>
    <button class="nav-btn" onclick="switchTab('tab-keepforever')" style="color:var(--gold)">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> Keep Forever
    </button>
  </nav>

  <div class="nav-save">
    <button class="btn-save-main" onclick="exportJournal()">Save My Journal</button>
    <div class="save-sub">Download your permanent backup file</div>
  </div>
</aside>

<!-- ════════════════════════════════════════════════
     MAIN CONTENT
════════════════════════════════════════════════ -->
<main>

<!-- ── TAB 1: THE BEGINNING ── -->
<section id="tab-beginning" class="tab-panel active">
  <div class="section-header">
    <h2 class="section-title">The Beginning</h2>
    <p class="section-hook">"There was a moment when everything changed. This is where you write it down."</p>
  </div>

  <div class="card grid-2">
    <div>
      <div class="card-title">Finding Out</div>
      <div class="card-note">The exact moment. Before you told anyone.</div>
      <label>The date you found out</label>
      <input type="date" data-save="beg-date">
      <label>Where were you?</label>
      <input type="text" data-save="beg-where" placeholder="The bathroom. The doctor's office. Your car.">
      <label>What did you feel in that first minute?</label>
      <textarea data-save="beg-feeling" placeholder="Joy, fear, disbelief, all of it at once — there's no wrong answer."></textarea>
      <label>The first person you told</label>
      <input type="text" data-save="beg-first-told" placeholder="And what did you say?">
    </div>
    <div class="photo-slot">
      <div class="photo-slot-icon">📷</div>
      <div class="photo-slot-text">Upload a photo from this moment</div>
      <div class="photo-slot-sub">The test, a journal page, anything</div>
      <input type="file" accept="image/*" onchange="handlePhoto(this,'beg-photo')">
      <img id="img-beg-photo" style="display:none;" alt="">
      <div class="size-warning">Large photos are gently compressed to keep your journal fast forever.</div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">The Announcement</div>
    <div class="grid-2">
      <div>
        <label>When you shared the news</label>
        <input type="date" data-save="ann-date">
        <label>Who you told first</label>
        <input type="text" data-save="ann-who" placeholder="Family, friends, everyone at once...">
        <label>How it went</label>
        <textarea data-save="ann-how" placeholder="The plan, what actually happened, the reactions you'll never forget."></textarea>
      </div>
      <div class="photo-slot">
        <div class="photo-slot-icon">🎉</div>
        <div class="photo-slot-text">Announcement photo</div>
        <input type="file" accept="image/*" onchange="handlePhoto(this,'ann-photo')">
        <img id="img-ann-photo" style="display:none;" alt="">
        <div class="size-warning">Compressed gently to save space.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Gender Reveal</div>
    <div class="card-note">Only if you found out — and only what you want to remember.</div>
    <div class="grid-2">
      <div>
        <label>Did you find out?</label>
        <div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
          <button class="reveal-btn" data-val="yes" onclick="setReveal('yes',this)">Yes, we found out</button>
          <button class="reveal-btn" data-val="surprise" onclick="setReveal('surprise',this)">Kept it a surprise</button>
          <button class="reveal-btn" data-val="birth" onclick="setReveal('birth',this)">Found out at birth</button>
        </div>
        <label>What did you think it would be beforehand?</label>
        <input type="text" data-save="reveal-instinct" placeholder="Your gut feeling...">
        <label>The moment of the reveal</label>
        <textarea data-save="reveal-moment" placeholder="Where you were, who was there, what happened."></textarea>
        <label>Your first reaction</label>
        <textarea data-save="reveal-reaction" placeholder="Even if it surprised you."></textarea>
      </div>
      <div class="photo-slot">
        <div class="photo-slot-icon">🎊</div>
        <div class="photo-slot-text">Reveal photo or memory</div>
        <input type="file" accept="image/*" onchange="handlePhoto(this,'reveal-photo')">
        <img id="img-reveal-photo" style="display:none;" alt="">
        <div class="size-warning">Compressed gently.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Early Days</div>
    <div class="grid-2">
      <div>
        <label>Early symptoms you'll remember</label>
        <textarea data-save="early-symptoms" placeholder="The exhaustion, the nausea, the cravings that made no sense."></textarea>
        <label>What you were most afraid of</label>
        <textarea data-save="early-fear" placeholder="You don't have to soften it."></textarea>
      </div>
      <div>
        <label>What you were most hoping for</label>
        <textarea data-save="early-hope" placeholder="Healthy, happy, here."></textarea>
        <label>A note to yourself in these early weeks</label>
        <textarea data-save="early-note" placeholder="What do you want to remember about right now?"></textarea>
      </div>
    </div>
  </div>
</section>

<!-- ── TAB 2: MY JOURNEY ── -->
<section id="tab-journey" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">My Journey</h2>
    <p class="section-hook">"Tap a week. Write what you remember. There's no minimum entry size."</p>
  </div>

  <div class="weeks-grid" id="weeks-container"></div>

  <div class="card">
    <div class="week-label" id="week-label">Week 4</div>
    <div class="grid-2">
      <div>
        <label>How I felt this week</label>
        <textarea id="wk-feelings" oninput="saveWeek()" placeholder="Energy, emotions, quiet moments, hard ones too."></textarea>
        <div class="grid-2">
          <div>
            <label>Cravings</label>
            <input type="text" id="wk-cravings" oninput="saveWeek()" placeholder="Be specific. Bologna counts.">
          </div>
          <div>
            <label>Symptoms</label>
            <input type="text" id="wk-symptoms" oninput="saveWeek()" placeholder="Kicks, flutters, fatigue...">
          </div>
        </div>
        <label>A memory from this week</label>
        <textarea id="wk-memory" oninput="saveWeek()" style="min-height:80px" placeholder="One thing you don't want to forget."></textarea>
      </div>
      <div class="photo-slot">
        <div class="photo-slot-icon">🌿</div>
        <div class="photo-slot-text">Bump photo or memory</div>
        <div class="photo-slot-sub">One per week, saved automatically</div>
        <input type="file" accept="image/*" id="wk-photo-input">
        <img id="wk-photo-preview" style="display:none;" alt="">
        <div class="size-warning">Large photos are compressed to keep your journal snappy forever.</div>
      </div>
    </div>
  </div>
</section>

<!-- ── TAB 3: APPOINTMENTS ── -->
<section id="tab-appointments" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Appointments</h2>
    <p class="section-hook">"Every heartbeat check. Every question answered. Every good news moment."</p>
  </div>

  <div class="card">
    <div style="display:grid;grid-template-columns:130px 70px 1fr 2fr auto;gap:12px;margin-bottom:8px;">
      <div class="col-header">Date</div>
      <div class="col-header">Week</div>
      <div class="col-header">Provider</div>
      <div class="col-header">Notes & What They Said</div>
      <div></div>
    </div>
    <div id="appt-list"></div>
    <button class="btn-add" onclick="addAppt()">+ Add Appointment</button>
  </div>
</section>

<!-- ── TAB 4: ULTRASOUNDS ── -->
<section id="tab-ultrasounds" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Ultrasounds</h2>
    <p class="section-hook">"A window into their secret world before they arrive."</p>
  </div>
  <div id="ultrasound-list"></div>
  <button class="btn-add" onclick="addUltrasound()">+ Log a New Scan</button>
</section>

<!-- ── TAB 5: GETTING READY ── -->
<section id="tab-ready" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Getting Ready</h2>
    <p class="section-hook">"Preparing the nest. Making space for someone new."</p>
  </div>

  <div class="grid-2" style="align-items:start">
    <div>
      <div class="card">
        <div class="card-title">Birth Plan & Preferences</div>
        <div class="card-note">Not a contract — just your intentions.</div>
        <label>What kind of birth experience do you hope for?</label>
        <textarea data-save="bp-hope" placeholder="Atmosphere, pain management preferences, who you want in the room."></textarea>
        <label>What are you most nervous about?</label>
        <textarea data-save="bp-nervous" placeholder="It's okay to say it out loud here."></textarea>
        <label>Golden hour wishes</label>
        <textarea data-save="bp-golden" placeholder="Delayed cord clamping, skin to skin, quiet — whatever matters to you."></textarea>
        <label>Anything else your care team should know</label>
        <textarea data-save="bp-notes" placeholder="Allergies, previous experiences, specific requests."></textarea>
      </div>

      <div class="card">
        <div class="card-title">Nursery</div>
        <div class="grid-2">
          <div>
            <label>What the nursery looks like</label>
            <textarea data-save="nursery-desc" placeholder="Colors, vibe, what you imagined vs what happened."></textarea>
            <label>Still needs</label>
            <textarea data-save="nursery-needs" placeholder="The things still on the list."></textarea>
          </div>
          <div class="photo-slot" style="min-height:160px">
            <div class="photo-slot-icon">🪺</div>
            <div class="photo-slot-text">Nursery photo</div>
            <input type="file" accept="image/*" onchange="handlePhoto(this,'nursery-photo')">
            <img id="img-nursery-photo" style="display:none;" alt="">
            <div class="size-warning">Compressed gently.</div>
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="card">
        <div class="card-title">Hospital Bag</div>
        <div class="card-note">Check things off as you pack them. You've got this.</div>
        <div id="bag-checklist"></div>
        <div style="display:flex;gap:10px;margin-top:14px;align-items:center">
          <input type="text" id="bag-new-item" placeholder="Anything else you want to bring..." style="margin-bottom:0;flex:1">
          <button class="btn-add" style="margin-top:0;white-space:nowrap" onclick="addBagItem()">+ Add</button>
        </div>
      </div>

      <div class="card">
        <div class="card-title">For Your Support Person</div>
        <label>What to pack for them</label>
        <textarea data-save="bag-partner" placeholder="Change of clothes, snacks, phone charger, their own pillow..."></textarea>
        <label>What you need from them</label>
        <textarea data-save="bag-partner-role" placeholder="Advocate for me, don't leave the room, keep the energy calm..."></textarea>
      </div>
    </div>
  </div>
</section>

<!-- ── BABY NAMES TAB ── -->
<section id="tab-names" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Baby Names</h2>
    <p class="section-hook">"The ones that kept coming back. The ones that didn't make it. The one you chose."</p>
  </div>

  <div class="grid-2" style="align-items:start">
    <div>
      <div class="card">
        <div class="card-title">Girl Names</div>
        <label>Names we love</label>
        <textarea data-save="names-girl-love" style="min-height:120px" placeholder="The ones that felt right..."></textarea>
        <label>Names we ruled out</label>
        <textarea data-save="names-girl-out" placeholder="And why. The stories are often good."></textarea>
      </div>
      <div class="card">
        <div class="card-title">Boy Names</div>
        <label>Names we love</label>
        <textarea data-save="names-boy-love" style="min-height:120px" placeholder="The ones that kept coming back..."></textarea>
        <label>Names we ruled out</label>
        <textarea data-save="names-boy-out" placeholder="And why."></textarea>
      </div>
      <div class="card">
        <div class="card-title">Gender Neutral Names</div>
        <label>Names we considered</label>
        <textarea data-save="names-neutral" style="min-height:100px" placeholder="The ones that work either way..."></textarea>
      </div>
    </div>

    <div>
      <div class="card">
        <div class="card-title">Family Names to Honor</div>
        <div class="card-note">Grandparents, great-grandparents, someone who mattered.</div>
        <label>Names from your side</label>
        <textarea data-save="names-family-you" placeholder="The names and the stories behind them..."></textarea>
        <label>Names from their side</label>
        <textarea data-save="names-family-them" placeholder="The names and the stories behind them..."></textarea>
      </div>
      <div class="card" style="background:#3a1808;border-color:rgba(201,129,58,0.3)">
        <div class="card-title">The Name We Chose</div>
        <label>First name</label>
        <input type="text" data-save="names-chosen-first" placeholder="Only if you're ready to write it down...">
        <label>Middle name</label>
        <input type="text" data-save="names-chosen-middle" placeholder="If you have one...">
        <label>Why this name</label>
        <textarea data-save="names-chosen-why" style="min-height:140px" placeholder="The meaning, the person it honors, the moment you both knew. She'll want to know this someday."></textarea>
      </div>
    </div>
  </div>
</section>

<!-- ── TAB 5b: BABY SHOWER ── -->
<section id="tab-shower" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Baby Shower</h2>
    <p class="section-hook">"The people who showed up. The gifts you'll remember. The thank you notes you'll actually send."</p>
  </div>

  <div class="card">
    <div class="card-title">The Shower</div>
    <div class="grid-2">
      <div>
        <label>Date</label>
        <input type="date" data-save="shower-date">
        <label>Hosted by</label>
        <input type="text" data-save="shower-host" placeholder="The people who made it happen.">
        <label>Where</label>
        <input type="text" data-save="shower-where" placeholder="Someone's home, a restaurant, a garden...">
        <label>Who was there</label>
        <textarea data-save="shower-who" placeholder="The people who came to celebrate her before she arrived."></textarea>
        <label>A memory from the day</label>
        <textarea data-save="shower-memory" placeholder="The game that made everyone laugh, the moment that made you cry, the thing you'll never forget."></textarea>
      </div>
      <div class="photo-slot">
        <div class="photo-slot-icon">🎀</div>
        <div class="photo-slot-text">Baby shower photo</div>
        <input type="file" accept="image/*" onchange="handlePhoto(this,'shower-photo')">
        <img id="img-shower-photo" style="display:none;" alt="">
        <div class="size-warning">Compressed gently.</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Gifts & Thank You Cards</div>
    <div class="card-note">Log every gift. Check off each thank you card as it goes out.</div>
    
    <div style="display:flex;gap:12px;margin-bottom:20px;align-items:flex-end;flex-wrap:wrap;">
      <div style="flex:2">
        <label>Gift</label>
        <input type="text" id="gift-item" placeholder="e.g. KitchenAid mixer, baby monitor, handmade quilt..." style="margin-bottom:0">
      </div>
      <div style="flex:1.5">
        <label>From</label>
        <input type="text" id="gift-from" placeholder="Who gave it" style="margin-bottom:0">
      </div>
      <button class="btn-add" style="margin-top:0;align-self:flex-end;" onclick="addGift()">+ Add Gift</button>
    </div>

    <div style="display:grid;grid-template-columns:2fr 1.5fr auto auto;gap:12px;margin-bottom:8px;">
      <div class="col-header">Gift</div>
      <div class="col-header">From</div>
      <div class="col-header">Thank You Sent</div>
      <div></div>
    </div>

    <div id="gift-list"></div>

    <div style="margin-top:20px;padding:16px;background:var(--sage-light);border-radius:8px;display:flex;gap:32px;">
      <div style="text-align:center">
        <div style="font-family:'Cormorant Garamond',serif;font-size:36px;color:var(--gold)" id="gift-total">0</div>
        <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted)">Total Gifts</div>
      </div>
      <div style="text-align:center">
        <div style="font-family:'Cormorant Garamond',serif;font-size:36px;color:var(--sage)" id="gift-sent">0</div>
        <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted)">Thank You Sent</div>
      </div>
      <div style="text-align:center">
        <div style="font-family:'Cormorant Garamond',serif;font-size:36px;color:var(--blush)" id="gift-todo">0</div>
        <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted)">Still To Send</div>
      </div>
    </div>
  </div>
</section>

<!-- ── TAB 6: THE DAY ── -->
<section id="tab-theday" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">The Day</h2>
    <p class="section-hook">"The day that split your life into before and after."</p>
  </div>

  <div class="card card-blush">
    <div class="grid-3">
      <div>
        <label>Date & Time of Arrival</label>
        <input type="text" data-save="day-time" placeholder="e.g., Oct 28 at 6:14 AM">
      </div>
      <div>
        <label>Weight & Length</label>
        <input type="text" data-save="day-stats" placeholder="7 lbs 4 oz, 20 inches">
      </div>
      <div>
        <label>Who Was There</label>
        <input type="text" data-save="day-who" placeholder="Partner, nurses, doula...">
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Birth Story</div>
    <div class="card-note">Answer what you can. Leave the rest for later. There's no wrong way to tell this story.</div>

    <div class="prompt-block">
      <div class="prompt-q">Where were you when it started?</div>
      <textarea data-save="birth-q1" placeholder="Home, the grocery store, asleep at 3am — wherever you were."></textarea>
    </div>

    <div class="prompt-block">
      <div class="prompt-q">Who did you call first, and what did you say?</div>
      <textarea data-save="birth-q2" placeholder="The exact words, if you remember them."></textarea>
    </div>

    <div class="prompt-block">
      <div class="prompt-q">What was the drive or journey there like?</div>
      <textarea data-save="birth-q3" placeholder="The radio, the conversation, the silence."></textarea>
    </div>

    <div class="prompt-block">
      <div class="prompt-q">What was the hardest moment?</div>
      <textarea data-save="birth-q4" placeholder="You don't have to soften it."></textarea>
    </div>

    <div class="prompt-block">
      <div class="prompt-q">What kept you going?</div>
      <textarea data-save="birth-q5" placeholder="A person, a voice, something inside you."></textarea>
    </div>

    <div class="prompt-block">
      <div class="prompt-q">The moment she arrived — what happened?</div>
      <textarea data-save="birth-q6" style="min-height:130px" placeholder="As much or as little as you want to say."></textarea>
    </div>

    <div class="prompt-block">
      <div class="prompt-q">The first thing you said or thought.</div>
      <textarea data-save="birth-q7" placeholder="Even if it surprises you."></textarea>
    </div>

    <div class="prompt-block">
      <div class="prompt-q">What do you want her to know about the day she was born?</div>
      <textarea data-save="birth-q8" style="min-height:130px" placeholder="Write it to her, if you want. She'll read it someday."></textarea>
    </div>
  </div>

  <div class="card grid-2">
    <div class="photo-slot">
      <div class="photo-slot-icon">🌅</div>
      <div class="photo-slot-text">First photo together</div>
      <input type="file" accept="image/*" onchange="handlePhoto(this,'birth-photo1')">
      <img id="img-birth-photo1" style="display:none;" alt="">
      <div class="size-warning">Compressed gently.</div>
    </div>
    <div class="photo-slot">
      <div class="photo-slot-icon">🤍</div>
      <div class="photo-slot-text">Another memory from The Day</div>
      <input type="file" accept="image/*" onchange="handlePhoto(this,'birth-photo2')">
      <img id="img-birth-photo2" style="display:none;" alt="">
      <div class="size-warning">Compressed gently.</div>
    </div>
  </div>
</section>


<!-- ── QUESTIONS FOR MY OB ── -->
<section id="tab-ob-questions" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Questions for My OB</h2>
    <p class="section-hook">"The questions you thought of at 2am. Write them here before you forget."</p>
  </div>

  <div class="card">
    <div class="card-title">First Trimester</div>
    <div class="card-note">Weeks 4–12 — getting established, early testing, what to expect.</div>
    <div class="prompt-block">
      <div class="prompt-q">What prenatal tests do you recommend and when?</div>
      <textarea data-save="ob-q1" placeholder="What your provider said..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What vitamins and supplements should I be taking?</div>
      <textarea data-save="ob-q2" placeholder="Folic acid, DHA, iron, vitamin D..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What activities or exercise are safe right now?</div>
      <textarea data-save="ob-q3" placeholder="What your provider said..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What symptoms should send me to the ER?</div>
      <textarea data-save="ob-q4" placeholder="Know this one by heart."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">My own questions</div>
      <textarea data-save="ob-q5" style="min-height:120px" placeholder="Everything else on your list..."></textarea>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Second Trimester</div>
    <div class="card-note">Weeks 13–26 — anatomy scan, glucose test, movement.</div>
    <div class="prompt-block">
      <div class="prompt-q">What will the anatomy scan tell us and what happens if something looks different?</div>
      <textarea data-save="ob-q6" placeholder="What your provider said..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">When should I start feeling movement and what's normal?</div>
      <textarea data-save="ob-q7" placeholder="What your provider said..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What does the glucose test involve and how do I prepare?</div>
      <textarea data-save="ob-q8" placeholder="What your provider said..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">My own questions</div>
      <textarea data-save="ob-q9" style="min-height:120px" placeholder="Everything else on your list..."></textarea>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Third Trimester</div>
    <div class="card-note">Weeks 27–40 — birth prep, GBS test, the final stretch.</div>
    <div class="prompt-block">
      <div class="prompt-q">What are the signs of labor and when do I call you?</div>
      <textarea data-save="ob-q10" placeholder="The rule of thumb your provider gave you..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What is your philosophy on induction and what are my options?</div>
      <textarea data-save="ob-q11" placeholder="What your provider said..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What should I know about the GBS test?</div>
      <textarea data-save="ob-q12" placeholder="What your provider said..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">Labor & delivery questions</div>
      <textarea data-save="ob-q13" style="min-height:120px" placeholder="Pain management, who can be in the room, your specific concerns..."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">Pediatrician questions to ask before birth</div>
      <textarea data-save="ob-q14" style="min-height:100px" placeholder="Feeding, circumcision decisions, what to look for in the first days..."></textarea>
    </div>
  </div>
</section>

<!-- ── MEDICATIONS & SUPPLEMENTS ── -->
<section id="tab-medications" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Medications & Supplements</h2>
    <p class="section-hook">"Everything you are taking. Everything your providers need to know."</p>
  </div>

  <div class="card">
    <div class="card-title">My Daily Supplements</div>
    <div style="display:grid;grid-template-columns:2fr 1fr 1fr 2fr auto;gap:12px;margin-bottom:8px;">
      <div class="col-header">Supplement / Medication</div>
      <div class="col-header">Dose</div>
      <div class="col-header">When</div>
      <div class="col-header">Prescribed by / Notes</div>
      <div></div>
    </div>
    <div id="med-list"></div>
    <button class="btn-add" onclick="addMed()">+ Add Medication or Supplement</button>
  </div>

  <div class="card">
    <div class="card-title">Allergies & Reactions</div>
    <div class="card-note">Important for your care team to know.</div>
    <label>Known allergies or sensitivities</label>
    <textarea data-save="med-allergies" placeholder="Medications, foods, environmental — anything your care team should know."></textarea>
    <label>Previous reactions or concerns</label>
    <textarea data-save="med-reactions" placeholder="How your body has reacted to medications or treatments in the past."></textarea>
  </div>

  <div class="card">
    <div class="card-title">Safe Medications During Pregnancy</div>
    <div class="card-note">Always confirm with your provider. This is your personal reference, not medical advice.</div>
    <div class="grid-2">
      <div>
        <label>Provider-approved for headaches / pain</label>
        <textarea data-save="med-safe1" placeholder="What your OB said is okay..."></textarea>
        <label>Provider-approved for nausea</label>
        <textarea data-save="med-safe2" placeholder="What your OB said is okay..."></textarea>
      </div>
      <div>
        <label>Provider-approved for sleep</label>
        <textarea data-save="med-safe3" placeholder="What your OB said is okay..."></textarea>
        <label>Other approved medications</label>
        <textarea data-save="med-safe4" placeholder="What your OB said is okay..."></textarea>
      </div>
    </div>
  </div>
</section>

<!-- ── BABY REGISTRY ── -->
<section id="tab-registry" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Baby Registry</h2>
    <p class="section-hook">"Where you registered. What you actually need. What you're still waiting on."</p>
  </div>

  <div class="card">
    <div class="card-title">My Registries</div>
    <div class="card-note">Add each store where you registered. The URL becomes a live link.</div>
    <div id="registry-list"></div>
    <button class="btn-add" onclick="addRegistry()">+ Add Registry</button>
  </div>

  <div class="card">
    <div class="card-title">Must Have Items</div>
    <div class="card-note">The things you researched and decided on. Your actual picks, not a generic list.</div>
    <div class="grid-2">
      <div>
        <label>Sleep</label>
        <textarea data-save="reg-sleep" placeholder="Bassinet, monitor, swaddles, sound machine..."></textarea>
        <label>Feeding</label>
        <textarea data-save="reg-feeding" placeholder="Breast pump, bottles, nursing pillow, nursing bras..."></textarea>
        <label>Diapering</label>
        <textarea data-save="reg-diaper" placeholder="Brand of diapers, wipes, changing pad, diaper pail..."></textarea>
      </div>
      <div>
        <label>Getting around</label>
        <textarea data-save="reg-travel" placeholder="Stroller, car seat, carrier, travel system..."></textarea>
        <label>Bath time</label>
        <textarea data-save="reg-bath" placeholder="Baby tub, gentle wash, soft towels..."></textarea>
        <label>Everything else</label>
        <textarea data-save="reg-other" placeholder="The things that didn't fit a category but you knew you needed..."></textarea>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Still Needed After the Shower</div>
    <div class="card-note">What came off the registry and what's still on the list.</div>
    <textarea data-save="reg-still-needed" style="min-height:120px" placeholder="The big items people don't always buy, the things you'll pick up yourself..."></textarea>
  </div>
</section>

<!-- ── BABYMOON ── -->
<section id="tab-babymoon" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Babymoon</h2>
    <p class="section-hook">"One last trip together. Just the two of you. Before everything changed beautifully."</p>
  </div>

  <div class="card grid-2">
    <div>
      <div class="card-title">The Trip</div>
      <label>Where you went</label>
      <input type="text" data-save="moon-where" placeholder="City, beach, mountains, your own backyard...">
      <label>When</label>
      <input type="date" data-save="moon-date">
      <label>How far along you were</label>
      <input type="text" data-save="moon-weeks" placeholder="e.g. 28 weeks">
      <label>Who came with you</label>
      <input type="text" data-save="moon-who" placeholder="Partner, best friend, your mom...">
      <label>Where you stayed</label>
      <input type="text" data-save="moon-stayed" placeholder="Hotel, Airbnb, family home...">
    </div>
    <div class="photo-slot">
      <div class="photo-slot-icon">🌙</div>
      <div class="photo-slot-text">Babymoon photo</div>
      <input type="file" accept="image/*" onchange="handlePhoto(this,'moon-photo')">
      <img id="img-moon-photo" style="display:none;" alt="">
      <div class="size-warning">Compressed gently.</div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Memories</div>
    <div class="prompt-block">
      <div class="prompt-q">Why you chose this trip</div>
      <textarea data-save="moon-why" placeholder="What made you pick this place, this time, these people."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">The best moment</div>
      <textarea data-save="moon-best" placeholder="The meal, the view, the conversation, the quiet."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What you talked about</div>
      <textarea data-save="moon-talked" placeholder="Names, fears, dreams, what kind of parents you want to be."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What you want to remember</div>
      <textarea data-save="moon-remember" placeholder="Before everything changed beautifully."></textarea>
    </div>
  </div>
</section>

<!-- ── MY VILLAGE ── -->
<section id="tab-village" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">My Village</h2>
    <p class="section-hook">"It takes a village. Build yours before you need it."</p>
  </div>

  <div class="card">
    <div class="card-title">Support Team</div>
    <div class="card-note">The fourth trimester is hard. Get as much support as you can for the first 6–8 weeks. It is better to have too much than not enough.</div>
    
    <div style="display:grid;grid-template-columns:1.5fr 2fr 1fr;gap:12px;margin-bottom:8px;">
      <div class="col-header">Role</div>
      <div class="col-header">Name & Contact</div>
      <div class="col-header">Cost / Notes</div>
    </div>

    <div id="village-list"></div>
    <button class="btn-add" onclick="addVillager()">+ Add Someone to Your Village</button>
  </div>

  <div class="card">
    <div class="card-title">Emergency Contacts</div>
    <div class="grid-2">
      <div>
        <label>OB / Midwife after-hours line</label>
        <input type="text" data-save="village-ob-phone" placeholder="Number to call at 2am">
        <label>Pediatrician</label>
        <input type="text" data-save="village-ped-phone" placeholder="Name and number">
        <label>Hospital / Birth center</label>
        <input type="text" data-save="village-hospital" placeholder="Address and main number">
      </div>
      <div>
        <label>Lactation consultant</label>
        <input type="text" data-save="village-lactation" placeholder="Name and number">
        <label>Trusted family member or friend on call</label>
        <input type="text" data-save="village-family" placeholder="Who to call when you just need someone">
        <label>Poison control</label>
        <input type="text" data-save="village-poison" placeholder="1-800-222-1222 (US)">
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Meal Train & Help Coordination</div>
    <div class="card-note">Who is bringing food. Who is helping with what. Written down so you don't have to remember.</div>
    <textarea data-save="village-meals" style="min-height:140px" placeholder="Who signed up for meals, what nights, any dietary notes. Who is helping with older kids, pets, errands. The people who said 'let me know if you need anything' — and what you're actually going to ask them for."></textarea>
  </div>
</section>

<!-- ── POSTPARTUM ── -->
<section id="tab-postpartum" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Postpartum</h2>
    <p class="section-hook">"The fourth trimester nobody warns you about. You are not alone in this."</p>
  </div>

  <div class="card card-blush">
    <div class="card-title">Your Body</div>
    <div class="card-note">Your body just did something extraordinary. Give it grace and time.</div>
    <div class="grid-2">
      <div>
        <label>Physical recovery notes</label>
        <textarea data-save="pp-body" placeholder="What recovery looked like, what surprised you, what helped."></textarea>
        <label>What your provider said at your postpartum checkup</label>
        <textarea data-save="pp-checkup" placeholder="6-week visit notes, clearances, concerns addressed."></textarea>
      </div>
      <div>
        <label>What helped you heal</label>
        <textarea data-save="pp-heal" placeholder="Rest, support, specific products, specific people."></textarea>
        <label>What you wish someone had told you</label>
        <textarea data-save="pp-wish" placeholder="For the next time, or for a friend who will go through this."></textarea>
      </div>
    </div>
  </div>

  <div class="card card-sage">
    <div class="card-title">Your Mind</div>
    <div class="card-note">Postpartum emotions are real, common, and not your fault. This is a safe place to write them down.</div>
    <div class="prompt-block">
      <div class="prompt-q">How are you, really?</div>
      <textarea data-save="pp-really" placeholder="Not the answer you give when people ask. The real one."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What has been harder than you expected?</div>
      <textarea data-save="pp-harder" placeholder="You don't have to soften it here."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What has surprised you in a good way?</div>
      <textarea data-save="pp-surprised" placeholder="The love you didn't know was possible. The resilience you didn't know you had."></textarea>
    </div>
    <div class="prompt-block">
      <div class="prompt-q">What do you need right now?</div>
      <textarea data-save="pp-need" placeholder="Sleep, help, someone to listen, permission to not be okay — whatever it is."></textarea>
    </div>
    <div style="background:var(--blush-pale);border:1px solid #e8c8bc;border-radius:8px;padding:20px;margin-top:8px;">
      <div style="font-family:'Cormorant Garamond',serif;font-size:17px;color:var(--bark);margin-bottom:8px;font-weight:600;">If you are struggling</div>
      <div style="font-size:13px;color:var(--text-mid);line-height:1.7">Postpartum depression and anxiety are common and treatable. Please talk to your provider. Postpartum Support International helpline: <strong>1-800-944-4773</strong>. You deserve support too.</div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Feeding</div>
    <div class="grid-2">
      <div>
        <label>How you chose to feed</label>
        <textarea data-save="pp-feed-how" placeholder="Breastfeeding, formula, combination — your choice, your reasons."></textarea>
        <label>What worked</label>
        <textarea data-save="pp-feed-worked" placeholder="Positions, timing, products, support people."></textarea>
      </div>
      <div>
        <label>What was hard</label>
        <textarea data-save="pp-feed-hard" placeholder="Honest and without judgment."></textarea>
        <label>What you want to remember or do differently</label>
        <textarea data-save="pp-feed-remember" placeholder="For next time, or just for the record."></textarea>
      </div>
    </div>
  </div>
</section>

<!-- ── TAB 7: FIRST YEAR ── -->
<section id="tab-firstyear" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">The First Year</h2>
    <p class="section-hook">"Tap a month before it blurs."</p>
  </div>
  <div id="firstyear-accordion"></div>
</section>

<!-- ── TAB 8: KEEP FOREVER ── -->
<section id="tab-keepforever" class="tab-panel">
  <div class="section-header">
    <h2 class="section-title">Keep Forever</h2>
    <p class="section-hook">"The digital longevity promise from Ever After Memory Co."</p>
  </div>

  <div class="letter-box">
    <div class="letter-prose">
      Dear Mama,
      <br><br>
      Memories are not meant to be rented, trapped behind corporate passwords, or erased when a subscription expires. We built this journal to belong entirely and exclusively to you.
      <br><br>
      Every craving logged, every fear written in the quiet hours, every bump photo, every name you considered — all of it lives securely within the private, local ecosystem of your own web browser. No trackers. No external servers. No one can see this but you.
      <br><br>
      To make certain these pages travel with you to your next device, and eventually find their way into your daughter's hands twenty-five years from now — click the button below. It packages everything into a single backup file that is forever yours.
      <br><br>
      Save it somewhere that matters. Your Google Drive. A USB drive in a box with her hospital bracelet. Emailed to yourself on her first birthday.
      <br><br>
      This journal is not an app. It will not be discontinued. HTML is the language the entire internet is built on — it worked in 1995 and it will work in 2045. Your story is safe.
    </div>
    <div class="letter-signoff">Warmly,<br>The Ever After Memory Co. Team</div>

    <div style="margin-top:48px;padding-top:32px;border-top:1px solid var(--border);display:flex;gap:24px;align-items:flex-start;flex-wrap:wrap;">
      <div>
        <button class="btn-save-main" style="width:auto;padding:14px 32px;" onclick="exportJournal()">Download My Backup File</button>
        <div style="font-size:11px;color:var(--text-muted);margin-top:8px;">Creates a .json file with everything inside</div>
      </div>
      <div style="flex:1;min-width:240px;">
        <label style="color:var(--text);font-weight:600;font-size:12px;margin-bottom:6px;">Restore from a backup file</label>
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px;">Moving to a new device? Import your backup and everything appears instantly.</div>
        <input type="file" id="import-input" accept=".json" onchange="importJournal(this)" style="font-size:12px;margin-bottom:0;">
      </div>
    </div>
  </div>
</section>

</main>

<div id="save-toast">✦ Saved</div>

<!-- ════════════════════════════════════════════════
     REVEAL BUTTON STYLES (inline so no class conflict)
════════════════════════════════════════════════ -->
<style>
.reveal-btn {
  background: #3e2010;
  border: 1px solid var(--border);
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 13px;
  cursor: pointer;
  color: var(--text-muted);
  transition: all 0.15s;
  font-family: 'DM Sans', sans-serif;
}
.reveal-btn:hover { border-color: var(--blush); color: var(--blush); }
.reveal-btn.selected { background: var(--blush); color: white; border-color: var(--blush); font-weight: 600; }
</style>

<script>
// ── STATE ──
let store = {
  texts: {}, images: {}, reveal: '',
  appointments: [], ultrasounds: [],
  weeks: {}, firstYear: {}
};
let activeWeek = 4;
const KEY = 'EAMC_PJ_CanyonBloom_v1';

// ── INIT ──
window.onload = () => {
  loadStore();
  bindTextInputs();
  renderWeeks();
  renderAppts();
  renderUltrasounds();
  renderFirstYear();
  selectWeek(4);
  restoreReveal();
  restoreImages();
  if (!store.gifts) store.gifts = [];
  renderGifts();
  renderMeds();
  renderRegistry();
  renderVillage();
  if(!store.bagItems) store.bagItems = DEFAULT_BAG_ITEMS ? DEFAULT_BAG_ITEMS.map(t=>({text:t,checked:false})) : [];
  renderBagChecklist();
};

// ── TAB SWITCHING ──
function switchTab(id) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const btn = Array.from(document.querySelectorAll('.nav-btn'))
    .find(b => b.getAttribute('onclick').includes(id));
  if (btn) btn.classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ── STORAGE ──
function loadStore() {
  try {
    const raw = localStorage.getItem(KEY);
    if (raw) store = Object.assign(store, JSON.parse(raw));
    if (!store.texts)        store.texts = {};
    if (!store.images)       store.images = {};
    if (!store.appointments) store.appointments = [];
    if (!store.ultrasounds)  store.ultrasounds = [];
    if (!store.weeks)        store.weeks = {};
    if (!store.firstYear)    store.firstYear = {};
    if (!store.meds)          store.meds = [];
    if (!store.registries)    store.registries = [];
    if (!store.villagers)     store.villagers = [];
    if (!store.bagItems)      store.bagItems = null;
  } catch(e) { console.warn('Load error'); }
}

let saveTimer;
function save() {
  clearTimeout(saveTimer);
  saveTimer = setTimeout(() => {
    try { localStorage.setItem(KEY, JSON.stringify(store)); toast(); }
    catch(e) { console.warn('Save error - storage may be full'); }
  }, 500);
}

function toast() {
  const t = document.getElementById('save-toast');
  t.style.opacity = 1;
  setTimeout(() => t.style.opacity = 0, 1800);
}

// ── TEXT INPUTS ──
function bindTextInputs() {
  document.querySelectorAll('[data-save]').forEach(el => {
    const k = el.getAttribute('data-save');
    if (store.texts[k]) el.value = store.texts[k];
    el.addEventListener('input', () => { store.texts[k] = el.value; save(); });
  });
}

// ── PHOTO UPLOADS ──
function handlePhoto(input, key) {
  const file = input.files[0];
  if (!file) return;
  const slot = input.closest('.photo-slot');
  const warn = slot?.querySelector('.size-warning');
  if (file.size > 800000 && warn) warn.style.display = 'block';

  const reader = new FileReader();
  reader.onload = e => {
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      let w = img.width, h = img.height;
      const max = 900;
      if (w > h && w > max) { h = h*max/w; w = max; }
      else if (h > w && h > max) { w = w*max/h; h = max; }
      else if (w > max) { h = h*max/w; w = max; }
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      const data = canvas.toDataURL('image/jpeg', 0.82);
      store.images[key] = data;
      const preview = document.getElementById('img-' + key);
      if (preview) { preview.src = data; preview.style.display = 'block'; }
      save();
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

function restoreImages() {
  Object.entries(store.images).forEach(([key, src]) => {
    const el = document.getElementById('img-' + key);
    if (el) { el.src = src; el.style.display = 'block'; }
  });
}

// ── GENDER REVEAL BUTTONS ──
function setReveal(val, btn) {
  document.querySelectorAll('.reveal-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  store.reveal = val;
  save();
}

function restoreReveal() {
  if (store.reveal) {
    const btn = document.querySelector(`.reveal-btn[data-val="${store.reveal}"]`);
    if (btn) btn.classList.add('selected');
  }
}

// ── WEEKS ──
function renderWeeks() {
  const c = document.getElementById('weeks-container');
  c.innerHTML = '';
  for (let w = 4; w <= 40; w++) {
    const btn = document.createElement('button');
    btn.className = 'btn-week' + (w === activeWeek ? ' active' : '');
    btn.textContent = `Wk ${w}`;
    btn.onclick = () => selectWeek(w);
    c.appendChild(btn);
  }
}

function selectWeek(w) {
  activeWeek = w;
  document.querySelectorAll('.btn-week').forEach(b =>
    b.classList.toggle('active', b.textContent === `Wk ${w}`)
  );
  document.getElementById('week-label').textContent = `Week ${w}`;
  const d = store.weeks[w] || {};
  document.getElementById('wk-feelings').value = d.feelings || '';
  document.getElementById('wk-cravings').value  = d.cravings  || '';
  document.getElementById('wk-symptoms').value  = d.symptoms  || '';
  document.getElementById('wk-memory').value    = d.memory    || '';
  const prev = document.getElementById('wk-photo-preview');
  const warn = document.getElementById('wk-photo-input').closest('.photo-slot')?.querySelector('.size-warning');
  if (warn) warn.style.display = 'none';
  if (d.photo) { prev.src = d.photo; prev.style.display = 'block'; }
  else         { prev.style.display = 'none'; prev.src = ''; }

  document.getElementById('wk-photo-input').onchange = function() {
    const file = this.files[0]; if (!file) return;
    if (file.size > 800000 && warn) warn.style.display = 'block';
    const reader = new FileReader();
    reader.onload = e => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        let cw = img.width, ch = img.height;
        const max = 900;
        if (cw > ch && cw > max) { ch = ch*max/cw; cw = max; }
        else if (ch > cw && ch > max) { cw = cw*max/ch; ch = max; }
        else if (cw > max) { ch = ch*max/cw; cw = max; }
        canvas.width = cw; canvas.height = ch;
        canvas.getContext('2d').drawImage(img,0,0,cw,ch);
        const data = canvas.toDataURL('image/jpeg',0.82);
        if (!store.weeks[activeWeek]) store.weeks[activeWeek] = {};
        store.weeks[activeWeek].photo = data;
        prev.src = data; prev.style.display = 'block';
        save();
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  };
}

function saveWeek() {
  if (!store.weeks[activeWeek]) store.weeks[activeWeek] = {};
  store.weeks[activeWeek].feelings = document.getElementById('wk-feelings').value;
  store.weeks[activeWeek].cravings  = document.getElementById('wk-cravings').value;
  store.weeks[activeWeek].symptoms  = document.getElementById('wk-symptoms').value;
  store.weeks[activeWeek].memory    = document.getElementById('wk-memory').value;
  save();
}

// ── APPOINTMENTS ──
function renderAppts() {
  const list = document.getElementById('appt-list');
  list.innerHTML = '';
  if (!store.appointments.length) store.appointments.push({date:'',week:'',provider:'',notes:''});
  store.appointments.forEach((a, i) => {
    const row = document.createElement('div');
    row.className = 'dynamic-row';
    row.innerHTML = `
      <input type="date" value="${a.date}" oninput="updateAppt(${i},'date',this.value)">
      <input type="text"  value="${a.week}" placeholder="Wk"  oninput="updateAppt(${i},'week',this.value)">
      <input type="text"  value="${a.provider}" placeholder="Provider" oninput="updateAppt(${i},'provider',this.value)">
      <input type="text"  value="${a.notes}" placeholder="Everything looks perfect..." oninput="updateAppt(${i},'notes',this.value)">
      <button class="btn-del" onclick="delAppt(${i})">×</button>`;
    list.appendChild(row);
  });
}

function addAppt() { store.appointments.push({date:'',week:'',provider:'',notes:''}); renderAppts(); save(); }
function updateAppt(i,f,v) { store.appointments[i][f]=v; save(); }
function delAppt(i) { store.appointments.splice(i,1); renderAppts(); save(); }

// ── ULTRASOUNDS ──
function renderUltrasounds() {
  const list = document.getElementById('ultrasound-list');
  list.innerHTML = '';
  if (!store.ultrasounds.length) store.ultrasounds.push({date:'',week:'',saw:'',felt:'',img:''});
  store.ultrasounds.forEach((u, i) => {
    const card = document.createElement('div');
    card.className = 'card grid-2';
    card.style.marginBottom = '24px';
    card.innerHTML = `
      <div>
        <div class="grid-2" style="margin-bottom:14px">
          <div><label>Date</label><input type="date" value="${u.date}" oninput="updateUltra(${i},'date',this.value)"></div>
          <div><label>Week</label><input type="text" placeholder="20 weeks" value="${u.week}" oninput="updateUltra(${i},'week',this.value)"></div>
        </div>
        <label>What we saw</label>
        <textarea placeholder="Counting ten perfectly formed toes, a strong heartbeat..." oninput="updateUltra(${i},'saw',this.value)" style="min-height:80px">${u.saw}</textarea>
        <label>What I felt</label>
        <textarea placeholder="Overwhelming awe. Relief. Love before you even knew what to call it." oninput="updateUltra(${i},'felt',this.value)" style="min-height:80px">${u.felt}</textarea>
        <button class="btn-del" style="font-size:13px;color:var(--text-muted);" onclick="delUltra(${i})">Remove this scan</button>
      </div>
      <div class="photo-slot">
        <div class="photo-slot-icon">🤍</div>
        <div class="photo-slot-text">Upload ultrasound image</div>
        <input type="file" accept="image/*" onchange="handleUltraPhoto(this,${i})">
        <img id="ultra-img-${i}" src="${u.img}" style="display:${u.img?'block':'none'}" alt="">
        <div class="size-warning">Compressed gently.</div>
      </div>`;
    list.appendChild(card);
  });
}

function addUltrasound() { store.ultrasounds.push({date:'',week:'',saw:'',felt:'',img:''}); renderUltrasounds(); save(); }
function updateUltra(i,f,v) { store.ultrasounds[i][f]=v; save(); }
function delUltra(i) { store.ultrasounds.splice(i,1); renderUltrasounds(); save(); }

function handleUltraPhoto(input, i) {
  const file = input.files[0]; if (!file) return;
  const slot = input.closest('.photo-slot');
  const warn = slot?.querySelector('.size-warning');
  if (file.size > 800000 && warn) warn.style.display='block';
  const reader = new FileReader();
  reader.onload = e => {
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      let w = img.width, h = img.height, max = 900;
      if (w > max) { h = h*max/w; w = max; }
      if (h > max) { w = w*max/h; h = max; }
      canvas.width=w; canvas.height=h;
      canvas.getContext('2d').drawImage(img,0,0,w,h);
      const data = canvas.toDataURL('image/jpeg',0.82);
      store.ultrasounds[i].img = data;
      const el = document.getElementById(`ultra-img-${i}`);
      el.src=data; el.style.display='block';
      save();
    };
    img.src=e.target.result;
  };
  reader.readAsDataURL(file);
}

// ── FIRST YEAR ACCORDION ──
const MONTHS = [
  'Month 1 — Fresh Arrival','Month 2','Month 3','Month 4',
  'Month 5','Month 6 — Halfway to One','Month 7','Month 8',
  'Month 9','Month 10','Month 11','Month 12 — First Birthday 🎂'
];

function renderFirstYear() {
  const c = document.getElementById('firstyear-accordion');
  c.innerHTML = '';
  MONTHS.forEach((label, idx) => {
    const k = `m${idx}`;
    const d = store.firstYear[k] || {milestones:'',letter:''};
    const item = document.createElement('div');
    item.className = 'accordion-item';
    item.innerHTML = `
      <button class="accordion-header" onclick="toggleAccordion(this)">
        <span style="font-family:'Cormorant Garamond',serif">${label}</span>
        <span class="arr" style="font-size:16px;color:var(--text-muted)">↓</span>
      </button>
      <div class="accordion-content">
        <div class="grid-2">
          <div>
            <label style="margin-top:10px">Milestones & Discoveries</label>
            <textarea placeholder="First real smile, first laugh, first food, first steps..." oninput="saveMonth('${k}','milestones',this.value)">${d.milestones}</textarea>
          </div>
          <div>
            <label style="margin-top:10px">A Letter to You This Month</label>
            <textarea placeholder="Watching you discover the world this month..." oninput="saveMonth('${k}','letter',this.value)">${d.letter}</textarea>
          </div>
        </div>
      </div>`;
    c.appendChild(item);
  });
}

function toggleAccordion(btn) {
  const parent = btn.parentElement;
  const wasOpen = parent.classList.contains('open');
  document.querySelectorAll('.accordion-item').forEach(el => {
    el.classList.remove('open');
    el.querySelector('.arr').textContent = '↓';
  });
  if (!wasOpen) {
    parent.classList.add('open');
    btn.querySelector('.arr').textContent = '↑';
  }
}

function saveMonth(k, field, val) {
  if (!store.firstYear[k]) store.firstYear[k] = {};
  store.firstYear[k][field] = val;
  save();
}

// ── EXPORT / IMPORT ──
function exportJournal() {
  const data = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(store));
  const a = document.createElement('a');
  a.href = data;
  a.download = 'EverAfter_Pregnancy_Journal_CanyonBloom_Backup.json';
  document.body.appendChild(a);
  a.click();
  a.remove();
}

function importJournal(input) {
  const file = input.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      store = Object.assign(store, JSON.parse(e.target.result));
      localStorage.setItem(KEY, JSON.stringify(store));
      window.location.reload();
    } catch(err) {
      alert('Could not read that backup file. Please make sure it is your original .json backup.');
    }
  };
  reader.readAsText(file);
}

// ── GIFT TRACKER ──
function renderGifts() {
  const list = document.getElementById('gift-list');
  if (!list) return;
  if (!store.gifts) store.gifts = [];
  list.innerHTML = '';
  store.gifts.forEach((g, i) => {
    const row = document.createElement('div');
    row.style.cssText = 'display:grid;grid-template-columns:2fr 1.5fr auto auto;gap:12px;align-items:center;padding:12px 0;border-bottom:1px dashed var(--border)';
    row.innerHTML = `
      <div style="font-size:14px;color:var(--text)">${g.item}</div>
      <div style="font-size:13px;color:var(--text-muted)">${g.from}</div>
      <div style="text-align:center">
        <input type="checkbox" ${g.sent?'checked':''} 
          style="width:18px;height:18px;accent-color:var(--sage);cursor:pointer"
          onchange="toggleThankYou(${i},this.checked)">
      </div>
      <button class="btn-del" onclick="delGift(${i})">×</button>`;
    list.appendChild(row);
  });
  updateGiftCounts();
}

function addGift() {
  const item = document.getElementById('gift-item').value.trim();
  const from = document.getElementById('gift-from').value.trim();
  if (!item) return;
  if (!store.gifts) store.gifts = [];
  store.gifts.push({item, from, sent: false});
  document.getElementById('gift-item').value = '';
  document.getElementById('gift-from').value = '';
  renderGifts();
  renderMeds();
  renderRegistry();
  renderVillage();
  if(!store.bagItems) store.bagItems = DEFAULT_BAG_ITEMS ? DEFAULT_BAG_ITEMS.map(t=>({text:t,checked:false})) : [];
  renderBagChecklist();
  save();
}

function toggleThankYou(i, val) {
  store.gifts[i].sent = val;
  updateGiftCounts();
  save();
}

function delGift(i) {
  store.gifts.splice(i, 1);
  renderGifts();
  renderMeds();
  renderRegistry();
  renderVillage();
  if(!store.bagItems) store.bagItems = DEFAULT_BAG_ITEMS ? DEFAULT_BAG_ITEMS.map(t=>({text:t,checked:false})) : [];
  renderBagChecklist();
  save();
}

function updateGiftCounts() {
  if (!store.gifts) return;
  const total = store.gifts.length;
  const sent = store.gifts.filter(g => g.sent).length;
  const el1 = document.getElementById('gift-total');
  const el2 = document.getElementById('gift-sent');
  const el3 = document.getElementById('gift-todo');
  if (el1) el1.textContent = total;
  if (el2) el2.textContent = sent;
  if (el3) el3.textContent = total - sent;
}


// ── MEDICATIONS ──
function renderMeds() {
  const list = document.getElementById('med-list');
  if (!list) return;
  if (!store.meds) store.meds = [];
  list.innerHTML = '';
  if (!store.meds.length) store.meds.push({name:'Prenatal Vitamin',dose:'1 daily',when:'Morning',notes:'OB recommended'});
  store.meds.forEach((m, i) => {
    const row = document.createElement('div');
    row.style.cssText = 'display:grid;grid-template-columns:2fr 1fr 1fr 2fr auto;gap:12px;align-items:center;padding:12px 0;border-bottom:1px dashed var(--border)';
    row.innerHTML = `
      <input type="text" value="${m.name}" placeholder="Prenatal vitamin, iron..." oninput="updateMed(${i},'name',this.value)" style="margin-bottom:0">
      <input type="text" value="${m.dose}" placeholder="400mg" oninput="updateMed(${i},'dose',this.value)" style="margin-bottom:0">
      <input type="text" value="${m.when}" placeholder="Morning" oninput="updateMed(${i},'when',this.value)" style="margin-bottom:0">
      <input type="text" value="${m.notes}" placeholder="Notes..." oninput="updateMed(${i},'notes',this.value)" style="margin-bottom:0">
      <button class="btn-del" onclick="delMed(${i})">×</button>`;
    list.appendChild(row);
  });
}
function addMed() { if(!store.meds)store.meds=[]; store.meds.push({name:'',dose:'',when:'',notes:''}); renderMeds(); save(); }
function updateMed(i,f,v) { store.meds[i][f]=v; save(); }
function delMed(i) { store.meds.splice(i,1); renderMeds(); save(); }

// ── REGISTRY ──
function renderRegistry() {
  const list = document.getElementById('registry-list');
  if (!list) return;
  if (!store.registries) store.registries = [];
  list.innerHTML = '';
  if (!store.registries.length) store.registries.push({store:'',url:'',notes:''});
  store.registries.forEach((r, i) => {
    const row = document.createElement('div');
    row.style.cssText = 'display:grid;grid-template-columns:1fr 2fr 1.5fr auto;gap:12px;align-items:center;padding:12px 0;border-bottom:1px dashed var(--border)';
    const linkDisplay = r.url ? `<a href="${r.url}" target="_blank" style="font-size:12px;color:var(--sage);margin-top:4px;display:block;word-break:break-all">${r.url}</a>` : '';
    row.innerHTML = `
      <input type="text" value="${r.store}" placeholder="Target, Amazon, Babylist..." oninput="updateRegistry(${i},'store',this.value)" style="margin-bottom:0">
      <div>
        <input type="text" value="${r.url}" placeholder="Paste your registry link here" oninput="updateRegistry(${i},'url',this.value)" style="margin-bottom:4px">
        ${linkDisplay}
      </div>
      <input type="text" value="${r.notes}" placeholder="Notes for guests..." oninput="updateRegistry(${i},'notes',this.value)" style="margin-bottom:0">
      <button class="btn-del" onclick="delRegistry(${i})">×</button>`;
    list.appendChild(row);
  });
}
function addRegistry() { if(!store.registries)store.registries=[]; store.registries.push({store:'',url:'',notes:''}); renderRegistry(); save(); }
function updateRegistry(i,f,v) { 
  store.registries[i][f]=v; 
  renderRegistry();
  save(); 
}
function delRegistry(i) { store.registries.splice(i,1); renderRegistry(); save(); }

// ── VILLAGE ──
const DEFAULT_VILLAGERS = [
  {role:'OB / Midwife',contact:'',cost:''},
  {role:'Lactation Consultant',contact:'',cost:''},
  {role:'Pelvic Floor Therapist',contact:'',cost:''},
  {role:'Pediatrician',contact:'',cost:''},
  {role:'Postpartum Doula',contact:'',cost:''},
  {role:'Night Nurse / Nanny',contact:'',cost:''},
  {role:'Therapist',contact:'',cost:''},
  {role:'House Cleaner',contact:'',cost:''},
];

function renderVillage() {
  const list = document.getElementById('village-list');
  if (!list) return;
  if (!store.villagers) store.villagers = DEFAULT_VILLAGERS.map(v => ({...v}));
  list.innerHTML = '';
  store.villagers.forEach((v, i) => {
    const row = document.createElement('div');
    row.style.cssText = 'display:grid;grid-template-columns:1.5fr 2fr 1fr auto;gap:12px;align-items:center;padding:12px 0;border-bottom:1px dashed var(--border)';
    row.innerHTML = `
      <input type="text" value="${v.role}" placeholder="Role or name" oninput="updateVillager(${i},'role',this.value)" style="margin-bottom:0">
      <input type="text" value="${v.contact}" placeholder="Name, phone, email..." oninput="updateVillager(${i},'contact',this.value)" style="margin-bottom:0">
      <input type="text" value="${v.cost}" placeholder="Cost / notes" oninput="updateVillager(${i},'cost',this.value)" style="margin-bottom:0">
      <button class="btn-del" onclick="delVillager(${i})">×</button>`;
    list.appendChild(row);
  });
}
function addVillager() { if(!store.villagers)store.villagers=[]; store.villagers.push({role:'',contact:'',cost:''}); renderVillage();
  if(!store.bagItems) store.bagItems = DEFAULT_BAG_ITEMS ? DEFAULT_BAG_ITEMS.map(t=>({text:t,checked:false})) : [];
  renderBagChecklist(); save(); }
function updateVillager(i,f,v) { store.villagers[i][f]=v; save(); }
function delVillager(i) { store.villagers.splice(i,1); renderVillage();
  if(!store.bagItems) store.bagItems = DEFAULT_BAG_ITEMS ? DEFAULT_BAG_ITEMS.map(t=>({text:t,checked:false})) : [];
  renderBagChecklist(); save(); }


// ── HOSPITAL BAG CHECKLIST ──
const DEFAULT_BAG_ITEMS = [
  "Hospital bag itself (obviously)",
  "Insurance card and ID",
  "Birth plan copies",
  "Phone charger (the long one)",
  "Comfy labor outfit",
  "Going home outfit for baby",
  "Going home outfit for you",
  "Nursing bra or breast pads",
  "Toiletries — your own shampoo makes a difference",
  "Snacks for your partner",
  "Pillow from home",
  "Camera or check phone storage",
  "Baby's first car seat (installed)",
  "A playlist, a podcast, something for the long parts"
];

function renderBagChecklist() {
  const list = document.getElementById('bag-checklist');
  if (!list) return;
  if (!store.bagItems) {
    store.bagItems = DEFAULT_BAG_ITEMS.map(text => ({text, checked: false}));
  }
  list.innerHTML = '';
  store.bagItems.forEach((item, i) => {
    const row = document.createElement('div');
    row.style.cssText = 'display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px dashed var(--border)';
    row.innerHTML = `
      <input type="checkbox" ${item.checked?'checked':''} 
        style="width:18px;height:18px;accent-color:var(--sage);cursor:pointer;flex-shrink:0"
        onchange="toggleBagItem(${i},this.checked)">
      <span style="flex:1;font-size:14px;color:${item.checked?'var(--text-muted)':'var(--text)'};text-decoration:${item.checked?'line-through':'none'}">${item.text}</span>
      <button class="btn-del" onclick="delBagItem(${i})" style="opacity:0.4;font-size:14px">×</button>`;
    list.appendChild(row);
  });
}

function addBagItem() {
  const input = document.getElementById('bag-new-item');
  const text = input.value.trim();
  if (!text) return;
  if (!store.bagItems) store.bagItems = [];
  store.bagItems.push({text, checked: false});
  input.value = '';
  renderBagChecklist();
  save();
}

function toggleBagItem(i, val) {
  store.bagItems[i].checked = val;
  renderBagChecklist();
  save();
}

function delBagItem(i) {
  store.bagItems.splice(i, 1);
  renderBagChecklist();
  save();
}

</script>
</body>
</html>

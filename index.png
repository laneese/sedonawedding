<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ever After Pregnancy Journal — Canyon Bloom Edition</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --cream:       #1a0d00;
      --cream-card:  #3d2010;
      --cream-deep:  #120900;
      --sage:        #c9813a;
      --sage-light:  #2e1808;
      --sage-mid:    #8a4820;
      --blush:       #d4956a;
      --blush-light: #523010;
      --blush-pale:  #4a2810;
      --gold:        #c9a84c;
      --gold-light:  #4a2810;
      --gold-rule:   #c9813a;
      --bark:        #e8c89a;
      --text:        #c4a882;
      --text-mid:    #b09070;
      --text-muted:  #9a7856;
      --border:      #7a4820;
      --border-soft: #6a3c18;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    <!-- CANYON_BG_PLACEHOLDER -->');
      background-size: cover;
      background-attachment: fixed;
      background-position: center;
      color: var(--text);
      line-height: 1.6;
      display: flex;
      min-height: 100vh;
      position: relative;
    }
    
    
    
    aside, main {
      position: relative;
      z-index: 1;
      padding: 52px 72px;
      max-width: 1080px;
      background-color: #f5e8d4;
    }

    /* ── SIDEBAR ── */
    aside {
      width: 272px;
      background: linear-gradient(180deg, #140800 0%, #0e0600 100%);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0; bottom: 0; left: 0;
      z-index: 50;
    }

    .brand {
      padding: 36px 24px 24px;
      text-align: center;
      border-bottom: 1px solid var(--border-soft);
    }

    .brand-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 13px;
      font-weight: 400;
      color: var(--text-muted);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .brand-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 600;
      color: #d4956a;
      line-height: 1.2;
      margin-bottom: 6px;
    }

    .brand-edition {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 15px;
      color: var(--text-muted);
    }

    .brand-rule {
      width: 40px;
      height: 1px;
      background: var(--gold-rule);
      margin: 14px auto 0;
      opacity: 0.5;
    }

    nav {
      flex: 1;
      padding: 16px 0;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(212,149,106,0.25) transparent;
    }
    nav::-webkit-scrollbar { width: 4px; }
    nav::-webkit-scrollbar-track { background: transparent; }
    nav::-webkit-scrollbar-thumb {
      background: rgba(212,149,106,0.25);
      border-radius: 4px;
    }
    nav::-webkit-scrollbar-thumb:hover { background: rgba(212,149,106,0.45); }

    /* Fade hint at bottom of nav to signal more tabs below */
    nav::after {
      content: '';
      position: sticky;
      bottom: 0;
      display: block;
      height: 40px;
      background: linear-gradient(to bottom, transparent, rgba(14,6,0,0.85));
      pointer-events: none;
      margin-top: -40px;
    }

    .nav-btn {
      width: 100%;
      background: none;
      border: none;
      text-align: left;
      padding: 11px 28px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13.5px;
      font-weight: 400;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.18s ease;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 0.01em;
    }

    .nav-btn:hover { color: var(--text); background-color: var(--blush-pale); }

    .nav-btn.active {
      color: #d4956a;
      background-color: rgba(201,129,58,0.10);
      border-left: 3px solid #c9813a;
      font-weight: 600;
      padding-left: 25px;
    }

    .nav-icon { display:inline-flex; align-items:center; flex-shrink: 0; }

    .nav-save {
      padding: 20px 20px 24px;
      border-top: 1px solid var(--border);
      background: #1e1000;
    }

    .btn-save-main {
      width: 100%;
      background: linear-gradient(135deg, #c9813a 0%, #a86428 100%);
      color: white;
      border: none;
      padding: 13px;
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      transition: opacity 0.2s;
      display: block;
      text-align: center;
    }

    .btn-save-main:hover { opacity: 0.88; }

    .save-sub {
      font-size: 10px;
      text-align: center;
      color: var(--text-muted);
      margin-top: 7px;
      line-height: 1.4;
    }

    /* ── MAIN CONTENT ── */
    main {
      margin-left: 272px;
      flex: 1;
      padding: 52px 72px;
      max-width: 1080px;
      position: relative;
    }
    main::before {
      content: '';
      position: fixed;
      top: 0;
      left: 272px;
      right: 0;
      bottom: 0;
      background-image: url('data:image/jpeg;base64,');
      background-size: 300px 300px;
      background-repeat: repeat;
      opacity: 0.25;
      pointer-events: none;
      z-index: 0;
    }
    main > * { position: relative; z-index: 1; }

    .tab-panel { display: none; animation: fadeUp 0.35s ease; }
    .tab-panel.active { display: block; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── TYPOGRAPHY ── */
    .section-header {
      margin-bottom: 36px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }

    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 44px;
      font-weight: 600;
      color: #8b4a1a;
      margin-bottom: 8px;
      line-height: 1.1;
    }

    .section-hook {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 18px;
      color: #7a3f18;
      font-weight: 400;
    }

    /* ── CARDS ── */
    .card {
      background: var(--cream-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 32px;
      margin-bottom: 28px;
      box-shadow: 0 2px 12px rgba(107,74,42,0.04);
    }

    .card-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 22px;
      font-weight: 600;
      color: #f5e8d4;
      margin-bottom: 6px;
    }

    .card-note {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 20px;
      font-style: italic;
    }

    .card-blush {
      background: #3a1406;
      border-color: #7a3018;
    }

    .card-sage {
      background: #2a1008;
      border-color: #6a2810;
    }

    /* ── GRID ── */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }

    /* ── FORM ── */
    label {
      display: block;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      margin-bottom: 8px;
      font-weight: 500;
    }

    input[type="text"], input[type="date"], textarea, select {
      width: 100%;
      padding: 11px 15px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: #3e2010;
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      color: var(--text);
      transition: border 0.2s, background 0.2s;
      margin-bottom: 16px;
    }

    input:focus, textarea:focus, select:focus {
      outline: none;
      border-color: var(--sage);
      background: #3e2010;
    }

    textarea { resize: vertical; min-height: 100px; }

    /* ── BIRTH PROMPTS ── */
    .prompt-block {
      margin-bottom: 24px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border-soft);
    }
    .prompt-block:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

    .prompt-q {
      font-family: 'Cormorant Garamond', serif;
      font-size: 19px;
      font-weight: 600;
      color: #f5e8d4;
      margin-bottom: 10px;
      line-height: 1.3;
    }

    /* ── PHOTO SLOTS ── */
    .photo-slot {
      border: 2px dashed rgba(212,149,106,0.45);
      border-radius: 8px;
      padding: 24px;
      text-align: center;
      background: rgba(212,149,106,0.06);
      cursor: pointer;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 200px;
      transition: border-color 0.2s, background 0.2s;
    }

    .photo-slot:hover {
      border-color: rgba(212,149,106,0.75);
      background: rgba(212,149,106,0.10);
    }
    .photo-slot img { position: absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; z-index:5; border-radius:6px; }
    .photo-slot input[type="file"] { position:absolute; top:0; left:0; width:100%; height:100%; opacity:0; cursor:pointer; z-index:10; }
    .photo-slot-icon { font-size: 28px; margin-bottom: 8px; z-index: 2; }
    .photo-slot-text { font-size: 13px; color: var(--sage); font-weight: 500; z-index: 2; }
    .photo-slot-sub { font-size: 11px; color: var(--text-muted); margin-top: 4px; z-index: 2; }

    .size-warning {
      font-size: 11px;
      color: #d4956a;
      margin-top: 8px;
      background: var(--gold-light);
      padding: 6px 10px;
      border-radius: 4px;
      border: 1px solid #e8d0a0;
      display: none;
      z-index: 2;
    }

    /* ── WEEKS GRID ── */
    .weeks-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(58px,1fr));
      gap: 7px;
      margin-bottom: 28px;
      max-height: 158px;
      overflow-y: auto;
      padding-right: 8px;
    }

    .btn-week {
      background: var(--cream-card);
      border: 1px solid var(--border);
      padding: 8px 4px;
      border-radius: 5px;
      font-size: 11.5px;
      cursor: pointer;
      text-align: center;
      color: var(--text-muted);
      transition: all 0.15s;
    }

    .btn-week:hover { border-color: var(--sage); color: var(--sage); }
    .btn-week.active { background: var(--sage); color: white; border-color: var(--sage); font-weight: 600; }

    .week-label {
      font-family: 'Cormorant Garamond', serif;
      font-size: 28px;
      color: #d4956a;
      margin-bottom: 20px;
    }

    /* ── DYNAMIC ROWS ── */
    .dynamic-row {
      display: grid;
      grid-template-columns: 130px 70px 1fr 2fr auto;
      gap: 12px;
      align-items: start;
      padding: 14px 0;
      border-bottom: 1px dashed var(--border);
    }

    .dynamic-row input { margin-bottom: 0; }

    .btn-add {
      background: #1e1000;
      color: var(--sage);
      border: 1px solid var(--sage-mid);
      padding: 9px 18px;
      border-radius: 5px;
      font-size: 12px;
      cursor: pointer;
      font-weight: 500;
      margin-top: 12px;
      transition: all 0.15s;
    }

    .btn-add:hover { background: var(--sage); color: white; }
    .btn-del { background: none; border: none; color: #c07070; cursor: pointer; font-size: 18px; padding: 4px; }

    /* ── ACCORDION ── */
    .accordion-item {
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 12px;
      background: #3e2010;
      overflow: hidden;
    }

    .accordion-header {
      width: 100%;
      padding: 18px 26px;
      text-align: left;
      background: var(--cream-card);
      border: none;
      font-family: 'Cormorant Garamond', serif;
      font-size: 21px;
      color: var(--text);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.18s;
    }

    .accordion-header:hover { background: var(--blush-pale); }

    .accordion-content {
      padding: 0 26px;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.32s ease, padding 0.32s ease;
      background: #3e2010;
    }

    .accordion-item.open .accordion-content {
      padding: 26px;
      max-height: 900px;
      border-top: 1px solid var(--border);
    }

    /* ── LETTER BOX (Keep Forever) ── */
    .letter-box {
      background: var(--cream-card);
      border: 1px solid var(--gold-rule);
      padding: 52px;
      border-radius: 10px;
      position: relative;
      box-shadow: 0 8px 28px rgba(184,144,90,0.07);
    }

    .letter-box::before {
      content: "";
      position: absolute;
      top: 8px; left: 8px; right: 8px; bottom: 8px;
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      pointer-events: none;
    }

    .letter-prose {
      font-family: 'Cormorant Garamond', serif;
      font-size: 21px;
      line-height: 1.85;
      color: var(--text-mid);
      margin-bottom: 32px;
    }

    .letter-signoff {
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 600;
      color: var(--sage);
      text-transform: uppercase;
      letter-spacing: 0.15em;
    }

    /* ── TOAST ── */
    #save-toast {
      position: fixed;
      bottom: 22px;
      right: 22px;
      background: var(--text);
      color: #2a1500;
      padding: 10px 22px;
      border-radius: 30px;
      font-size: 12px;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
      z-index: 200;
    }

    /* ── BUTTONS ── */
    .btn-primary {
      background: linear-gradient(135deg, var(--blush) 0%, #c07870 100%);
      color: white;
      border: none;
      padding: 11px 24px;
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: opacity 0.2s;
      margin-top: 4px;
    }

    .btn-primary:hover { opacity: 0.88; }

    .btn-primary.sage {
      background: linear-gradient(135deg, #c9813a 0%, #a86428 100%);
    }

    /* ── NAMES SECTION ── */
    .names-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

    /* ── COLUMN HEADERS ── */
    .col-header {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      font-weight: 600;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--border);
      margin-bottom: 4px;
    }
  </style>
</head>
<body>

<!-- ════════════════════════════════════════════════
     SIDEBAR
════════════════════════════════════════════════ -->
<aside>
  <div class="brand">
    <div class="brand-name">Ever After Memory Co.</div>
    <div class="brand-title">Pregnancy Journal</div>
    <div class="brand-edition">Canyon Bloom Edition</div>
    <div class="brand-rule"></div>
  </div>

  <nav>
    <button class="nav-btn active" onclick="switchTab('tab-beginning')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> The Beginning
    </button>
    <button class="nav-btn" onclick="switchTab('tab-journey')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> My Journey
    </button>
    <button class="nav-btn" onclick="switchTab('tab-appointments')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> Appointments
    </button>
    <button class="nav-btn" onclick="switchTab('tab-ob-questions')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> Questions for My OB
    </button>
    <button class="nav-btn" onclick="switchTab('tab-medications')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> Medications & Supplements
    </button>
    <button class="nav-btn" onclick="switchTab('tab-ultrasounds')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> Ultrasounds
    </button>
    <button class="nav-btn" onclick="switchTab('tab-ready')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60" width="14" height="14" style="flex-shrink:0;opacity:0.85">
          <path d="M30 52 Q30 30 30 10" fill="none" stroke="#c9813a" stroke-width="2" stroke-linecap="round"/>
          <path d="M30 18 Q18 14 16 22 Q20 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 18 Q42 14 44 22 Q40 26 30 22 Z" fill="#c9813a"/>
          <path d="M30 28 Q16 23 14 32 Q18 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 28 Q44 23 46 32 Q42 37 30 33 Z" fill="#c9813a" opacity="0.8"/>
          <path d="M30 38 Q17 33 15 42 Q20 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
          <path d="M30 38 Q43 33 45 42 Q40 48 30 44 Z" fill="#c9813a" opacity="0.6"/>
        </svg> Getting Ready
    </button>
    <button class="nav-btn" onclick="switchTab('tab-names')">
